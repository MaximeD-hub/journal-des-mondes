---
import { NAV_LINKS, SUPPORT_LINK, SITE_NAME } from '../consts';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="sticky top-0 z-50 bg-ink shadow-lg shadow-black/20">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3 sm:px-8">
    <a href="/" class="shrink-0 transition-transform duration-300 ease-out hover:scale-105" aria-label={`${SITE_NAME} — Accueil`}>
      <img 
        src="/images/logo-full.png"
        alt={SITE_NAME}
        class="h-16 w-auto -my-[14px] sm:h-20 sm:-my-4.5"
        width="220"
        height="101"
      />
    </a>

    <nav aria-label="Navigation principale" class="hidden lg:block">
      <ul class="flex items-center gap-7 font-sans text-[0.95rem] tracking-wide text-parchment-light">
        {NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class="relative py-1 transition-colors hover:text-gold aria-[current=page]:text-gold"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a
      href={SUPPORT_LINK.href}
      target="_blank"
      rel="noopener noreferrer"
      class="hidden shrink-0 rounded-full bg-gold px-5 py-2 font-sans text-sm font-semibold text-ink-dark transition-colors hover:bg-gold-light lg:inline-block"
    >
      {SUPPORT_LINK.label}
    </a>

    <button
      id="menu-toggle"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-md text-parchment-light lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Ouvrir le menu"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Navigation mobile"
    class="hidden border-t border-parchment/10 bg-ink lg:hidden"
  >
    <ul class="flex flex-col gap-1 px-5 py-4 font-sans text-parchment-light">
      {NAV_LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class="block rounded-md px-2 py-2.5 transition-colors hover:bg-white/5 hover:text-gold aria-[current=page]:text-gold"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="pt-2">
        <a
          href={SUPPORT_LINK.href}
          target="_blank"
          rel="noopener noreferrer"
          class="block rounded-full bg-gold px-5 py-2.5 text-center font-semibold text-ink-dark"
        >
          {SUPPORT_LINK.label}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-label', expanded ? 'Ouvrir le menu' : 'Fermer le menu');
  });
</script>
