---
import PlaceholderArt from './PlaceholderArt.astro';

interface Props {
  href: string;
  title: string;
  episodeNumber: number;
  chapterLabel?: string;
  coverImage?: string;
  style?: string;
}

const { href, title, episodeNumber, chapterLabel, coverImage, style } = Astro.props;
---

<a
  href={href}
  class="group relative block aspect-[16/10] w-64 shrink-0 overflow-hidden rounded-md shadow-md shadow-black/30 transition-transform duration-200 hover:z-10 hover:scale-105 sm:w-72"
  style={style}
>
  {coverImage ? (
    <img src={coverImage} alt="" class="h-full w-full object-cover" loading="lazy" />
  ) : (
    <PlaceholderArt variant="ink" class="h-full w-full" />
  )}
  <div class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-ink-dark/95 via-ink-dark/10 to-transparent p-3">
    <p class="font-sans text-xs font-semibold uppercase tracking-wider text-gold">
      {chapterLabel ?? `Épisode ${episodeNumber}`}
    </p>
    <p class="font-display text-base leading-tight text-parchment-light">{title}</p>
  </div>
</a>