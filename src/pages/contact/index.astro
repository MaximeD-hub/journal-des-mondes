---
import { CONTACT_EMAIL, SOCIAL_LINKS } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Contactez l'équipe du Journal des Mondes.">
  <section class="bg-parchment-light px-5 py-16 sm:px-8 sm:py-20">
    <div class="mx-auto grid max-w-5xl gap-12 lg:grid-cols-2">
      <!-- RÉSEAUX + EMAIL -->
      <div>
        <h1 class="font-display text-3xl text-ink sm:text-4xl">Contact</h1>
        <p class="mt-3 max-w-sm font-body text-ink/70">
          Une question, une envie de collaborer ? Écrivez-nous ou retrouvez-nous sur les réseaux.
        </p>

        <div class="mt-8">
          <h2 class="font-sans text-sm font-semibold uppercase tracking-wider text-gold-dark">
            Adresse mail
          </h2>
          <a href={`mailto:${CONTACT_EMAIL}`} class="mt-2 inline-block font-body text-lg text-ink underline decoration-gold decoration-2 underline-offset-4 hover:text-gold-dark">
            {CONTACT_EMAIL}
          </a>
        </div>

        <div class="mt-8">
          <h2 class="font-sans text-sm font-semibold uppercase tracking-wider text-gold-dark">
            Réseaux sociaux
          </h2>
          <ul class="mt-3 flex flex-col gap-2.5">
            {SOCIAL_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-body text-lg text-ink transition-colors hover:text-gold-dark"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- FORMULAIRE -->
      <div class="rounded-lg bg-ink p-8 sm:p-10">
        <form name="contact" method="POST" data-netlify="true" data-astro-reload netlify-honeypot="bot-field" class="flex flex-col gap-5">
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>
              Ne pas remplir si vous êtes humain : <input name="bot-field" />
            </label>
          </p>

          <div class="flex flex-col gap-1.5">
            <label for="name" class="font-sans text-sm text-parchment-light/80">Nom</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              class="rounded-md border border-parchment-light/20 bg-ink-light px-4 py-2.5 font-body text-parchment-light placeholder:text-parchment-light/30 focus:border-gold focus:outline-none"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="email" class="font-sans text-sm text-parchment-light/80">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="rounded-md border border-parchment-light/20 bg-ink-light px-4 py-2.5 font-body text-parchment-light placeholder:text-parchment-light/30 focus:border-gold focus:outline-none"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="subject" class="font-sans text-sm text-parchment-light/80">Sujet</label>
            <input
              id="subject"
              name="subject"
              type="text"
              class="rounded-md border border-parchment-light/20 bg-ink-light px-4 py-2.5 font-body text-parchment-light placeholder:text-parchment-light/30 focus:border-gold focus:outline-none"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="message" class="font-sans text-sm text-parchment-light/80">Message</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="resize-none rounded-md border border-parchment-light/20 bg-ink-light px-4 py-2.5 font-body text-parchment-light placeholder:text-parchment-light/30 focus:border-gold focus:outline-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="mt-2 w-fit rounded-full bg-gold px-7 py-3 font-sans text-sm font-semibold text-ink-dark transition-colors hover:bg-gold-light"
          >
            Envoyer le message
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
