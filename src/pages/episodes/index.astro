---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EpisodeCard from '../../components/EpisodeCard.astro';
import ScrollCarousel from '../../components/ScrollCarousel.astro';

const allEpisodes = await getCollection('episodes', ({ data }) => !data.draft);

// Groupe par saison, en gardant l'ordre d'apparition de la saison la plus récemment
// mise à jour, et les épisodes triés du plus récent au plus ancien dans chaque rangée.
const bySeasonMap = new Map<string, typeof allEpisodes>();
for (const ep of allEpisodes) {
  if (!bySeasonMap.has(ep.data.season)) {
    bySeasonMap.set(ep.data.season, []);
  }
  bySeasonMap.get(ep.data.season)!.push(ep);
}

const seasons = Array.from(bySeasonMap.entries())
  .map(([name, episodes]) => ({
    name,
    episodes: [...episodes].sort((a, b) => a.data.episodeNumber - b.data.episodeNumber),
    latestDate: Math.max(...episodes.map((ep) => ep.data.publishDate.valueOf())),
  }))
  .sort((a, b) => b.latestDate - a.latestDate);

function slugify(str: string) {
  return str
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
}
---

<BaseLayout title="Episodes">
  <section class="relative flex min-h-[320px] flex-col items-center justify-center bg-ink px-5 py-12 text-center sm:min-h-[400px] sm:px-8">
  <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/textures/parchment.jpg');"></div>
  <div class="relative mx-auto max-w-2xl">
    <h1 class="font-display text-3xl text-ink sm:text-4xl">Saisons</h1>
    <p class="mt-3 font-body text-ink/70">
      Les différentes pages du Journal des Mondes.
    </p>
  </div>

  <div class="relative mx-auto mt-8 max-w-md">
    <label for="episode-search" class="sr-only">Rechercher un épisode</label>
    <div class="relative">
      <input
        id="episode-search"
        type="search"
        placeholder="Rechercher un épisode"
        class="w-full rounded-full border border-ink/20 bg-parchment-light pl-5 pr-11 py-2.5 font-sans text-sm text-ink placeholder:text-ink/40 focus:border-gold focus:outline-none"
      />
      <svg xmlns="http://www.w3.org/2000/svg" class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-ink/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7" />
          <path stroke-linecap="round" d="m20 20-3.5-3.5" />
        </svg>
      </div>
    </div>
  </section>

  <section class="bg-ink-dark px-5 py-12 sm:px-8">
    <div class="mx-auto flex max-w-6xl flex-col gap-12" id="season-rows">
      {seasons.map((season) => (
        <div id={slugify(season.name)} class="season-row scroll-mt-24" data-season={season.name.toLowerCase()}>
          <h2 class="mb-4 font-display text-2xl text-parchment-light">
            {season.name}
          </h2>
          <ScrollCarousel trackClass="-mx-5 gap-4 px-5 py-2 sm:-mx-8 sm:px-8">
            {season.episodes.map((ep) => (
              <div class="episode-item" data-title={ep.data.title.toLowerCase()}>
                <EpisodeCard
                  href={`/episodes/${ep.id}`}
                  title={ep.data.title}
                  episodeNumber={ep.data.episodeNumber}
                  chapterLabel={ep.data.chapterLabel}
                  coverImage={ep.data.coverImage}
                  style={`transition-delay: ${season.episodes.indexOf(ep) * 80}ms`}
                />
              </div>
            ))}
          </ScrollCarousel>
        </div>
      ))}

      {seasons.length === 0 && (
        <p class="text-center font-body text-parchment-light/60">Aucun épisode publié pour le moment.</p>
      )}
    </div>
    <p id="no-results" class="hidden text-center font-body text-parchment-light/60">
      Aucun résultat pour cette recherche.
    </p>
  </section>
</BaseLayout>

<script>
  const input = document.getElementById('episode-search') as HTMLInputElement | null;
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.season-row'));
  const noResults = document.getElementById('no-results');

  input?.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    let anyVisible = false;

    rows.forEach((row) => {
      const seasonName = row.dataset.season ?? '';
      const items = Array.from(row.querySelectorAll<HTMLElement>('.episode-item'));
      let rowHasMatch = seasonName.includes(query);

      items.forEach((item) => {
        const matches = query === '' || seasonName.includes(query) || (item.dataset.title ?? '').includes(query);
        item.style.display = matches ? '' : 'none';
        if (matches) rowHasMatch = true;
      });

      row.style.display = rowHasMatch ? '' : 'none';
      if (rowHasMatch) anyVisible = true;
    });

    noResults?.classList.toggle('hidden', anyVisible);
  });
</script>
