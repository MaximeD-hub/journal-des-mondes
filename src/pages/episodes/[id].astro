---
import { getCollection, render } from 'astro:content';
import PlaceholderArt from '../../components/PlaceholderArt.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';


export async function getStaticPaths() {
  const episodes = await getCollection('episodes', ({ data }) => !data.draft);
  const sorted = [...episodes].sort(
    (a, b) => a.data.publishDate.valueOf() - b.data.publishDate.valueOf()
  );

  return sorted.map((entry, index) => ({
  params: { id: entry.id },
  props: { entry, previous: sorted[index - 1] ?? null, next: sorted[index + 1] ?? null },
}));
}

const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);
const { title, season, episodeNumber, chapterLabel, acastEmbedUrl, coverImage, publishDate} = entry.data;
const formattedDate = new Intl.DateTimeFormat('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(publishDate);
---

<BaseLayout title={title} description={entry.data.excerpt}>
  <!-- BANNIÈRE + INFOS -->
  <section class="bg-ink-dark px-5 py-10 sm:px-8 sm:py-14">
    <div class="mx-auto grid max-w-6xl gap-4 sm:grid-cols-[1.6fr_1fr]">
      {coverImage ? (
        <img src={coverImage} alt="" class="aspect-[16/10] w-full rounded-lg object-cover" loading="lazy" />
      ) : (
        <PlaceholderArt variant="ink" class="aspect-[16/10] w-full rounded-lg" />
        )}
      <div class="flex flex-col justify-center gap-2 rounded-lg bg-ink p-8">
        <p class="font-sans text-xs font-semibold uppercase tracking-wider text-gold">{season}</p>
        <p class="font-sans text-sm text-parchment-light/60">
          {chapterLabel ?? `Épisode ${episodeNumber}`}
        </p>
        <h1 class="mt-2 font-display text-3xl text-parchment-light sm:text-4xl">{title}</h1>
        <p class="font-sans text-sm text-parchment-light/60">
          Publié le {formattedDate}
        </p>
      </div>
    </div>
  </section>

  <!-- LECTEUR ACAST -->
  <section class="bg-parchment-light px-5 py-8 sm:px-8">
    <div class="mx-auto max-w-6xl">
      {acastEmbedUrl ? (
        <iframe
          src={acastEmbedUrl}
          title={`Lecteur — ${title}`}
          class="h-32 w-full rounded-lg border border-ink/10"
          loading="lazy"
        />
      ) : (
        <div class="flex h-32 w-full items-center justify-center rounded-lg border border-dashed border-ink/20 font-sans text-sm text-ink/50">
          Lecteur Acast à venir
        </div>
      )}
    </div>
  </section>

  <!-- DESCRIPTION -->
  <section class="bg-parchment-light px-5 py-8 sm:px-8 sm:py-12">
    <div class="prose prose-lg mx-auto max-w-3xl font-body text-ink prose-headings:font-display">
      <Content />
    </div>
  </section>

  <!-- ÉPISODE PRÉCÉDENT & SUIVANT -->
<section class="bg-parchment-light px-5 pb-16 sm:px-8">
  <div class="mx-auto flex max-w-3xl flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    {previous ? (
      <a
        href={`/episodes/${previous.id}`}
        class="inline-block rounded-full border border-ink/20 px-7 py-3 text-center font-sans text-sm font-semibold text-ink transition-colors hover:border-ink hover:bg-ink/5"
      >
        ← Épisode précédent : {previous.data.title}
      </a>
    ) : (
      <p class="font-sans text-sm text-ink/50">C'est le tout premier épisode publié.</p>
    )}
    {next ? (
      <a
        href={`/episodes/${next.id}`}
        class="inline-block rounded-full border border-ink/20 px-7 py-3 text-center font-sans text-sm font-semibold text-ink transition-colors hover:border-ink hover:bg-ink/5"
      >
        Épisode suivant : {next.data.title} →
      </a>
    ) : (
      <p class="font-sans text-sm text-ink/50">C'est le dernier épisode publié.</p>
    )}
  </div>
</section>
</BaseLayout>
